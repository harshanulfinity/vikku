# Supabase configuration (for authentication and database)
# Find these in your Supabase dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI configuration (BACKEND ONLY - NEVER use VITE_ prefix)
# Used for AI features like cost estimator, ROI calculator, etc.
# This key is ONLY used in serverless functions, never exposed to frontend
OPENAI_API_KEY=your_openai_api_key

# Razorpay configuration
# Find these in your Razorpay dashboard: https://dashboard.razorpay.com/
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend configuration (for sending invitation emails and the contact form)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Comma-separated list of emails allowed into /admin
VITE_ADMIN_EMAILS=admin@example.com
